# Application
APP_NAME=LMS Backend API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# Database (MySQL)
DATABASE_URL=mysql+pymysql://lms_user:change_me_password@127.0.0.1:3306/lms_db?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://lms_user:change_me_password@127.0.0.1:3306/lms_test_db?charset=utf8mb4

# Security / JWT
JWT_SECRET_KEY=replace-with-a-secure-random-64-char-hex-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File Storage (local | s3)
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_VIDEO_SIZE_MB=500
MAX_MATERIAL_SIZE_MB=50
MAX_ASSIGNMENT_FILE_SIZE_MB=25
MAX_IMAGE_SIZE_MB=5

# Optional S3 Object Storage (Production)
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# Optional Email / SMTP
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@institute-lms.example
FRONTEND_RESET_URL=http://localhost:5173/reset-password

# Institute Branding (Certificates & Receipts)
INSTITUTE_NAME=Apex Training Institute
INSTITUTE_TAGLINE=Center for Professional & Technical Excellence

# Rate Limiting
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_RESET=5/minute
